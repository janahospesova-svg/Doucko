# ============================================================
# CHYTRÁ TŘÍDA – NASTAVENÍ OBJEDNÁVEK
# ============================================================

# E-mail, kam mají chodit nové objednávky
ADMIN_EMAIL=tvuj@email.cz

# Tajný klíč pro administrátorské API
# Vymysli dlouhý náhodný řetězec a NIKDY ho nedávej do veřejného GitHubu.
ADMIN_KEY=zde-vytvor-dlouhy-tajny-klic-min-16-znaku

# Port webu
PORT=3000

# SQLite databáze
DATABASE_FILE=./data/orders.db

# ============================================================
# SMTP – údaje od tvého poskytovatele e-mailu
# ============================================================
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=tvuj@email.cz
SMTP_PASS=TVE_HESLO_NEBO_APP_PASSWORD

# Adresa, která se zobrazí jako odesílatel
MAIL_FROM=tvuj@email.cz
